# ============================================================
# CodeCompass Backend — Environment Variables
# Copy this file to .env and fill in each value before running
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Frontend URL (for CORS) ──────────────────────────────────
# Local dev
FRONTEND_URL=http://localhost:3000
# Production (your GitHub Pages URL)
# FRONTEND_URL=https://<your-github-username>.github.io

# ── Database (Supabase PostgreSQL) ──────────────────────────
# Find this in: Supabase → Project → Settings → Database → Connection string (URI mode)
DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?pgbouncer=true"
# Direct connection (used by Prisma migrations)
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# ── Supabase Auth ────────────────────────────────────────────
# Find in: Supabase → Project → Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# JWT secret: Supabase → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=<jwt-secret>

# ── OpenRouter (AI provider) ─────────────────────────────────
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Choose any OpenRouter model ID, e.g.:
#   anthropic/claude-3-5-sonnet
#   openai/gpt-4o
#   meta-llama/llama-3.1-70b-instruct
OPENROUTER_MODEL=anthropic/claude-3-5-sonnet

# ── Judge0 (code execution) ───────────────────────────────────
# Self-hosted or use RapidAPI hosted version:
#   https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=<rapidapi-key>
# Set to false if using self-hosted Judge0 without a key
JUDGE0_USE_RAPIDAPI=true

# ── Upstash Redis (rate limiting) ────────────────────────────
# Create a Redis database at: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://<id>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<token>

# ── Sentry (optional monitoring) ─────────────────────────────
# Leave empty to disable Sentry
SENTRY_DSN=
