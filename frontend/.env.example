# ============================================================
# CodeCompass Frontend — Environment Variables
# Copy this file to .env.local and fill in each value
# ============================================================

# ── Backend API URL ──────────────────────────────────────────
# Local development
NEXT_PUBLIC_API_URL=http://localhost:4000
# Production (your Railway backend URL)
# NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app

# ── Supabase (browser-safe — anon key only) ──────────────────
# Find in: Supabase → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ── GitHub Pages base path ────────────────────────────────────
# Set to your repository name when deploying to GitHub Pages
# e.g. if your repo is github.com/yourname/codecompass:
# NEXT_PUBLIC_BASE_PATH=/codecompass
# Leave empty for custom domain or local dev
NEXT_PUBLIC_BASE_PATH=

# ── Optional: PostHog analytics ──────────────────────────────
# Leave empty to disable PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Optional: Sentry (frontend error tracking) ───────────────
# Leave empty to disable Sentry
NEXT_PUBLIC_SENTRY_DSN=
